# Example Dunst configuration
# Symlinked to ~/.config/dunst/dunstrc via Stow:
#   bash scripts/80_dotfiles.sh dunst

[global]
    monitor = 0
    follow = mouse
    geometry = "300x50-20+55"
    transparency = 10
    frame_color = "#444444"
    separator_color = frame
    padding = 8
    horizontal_padding = 8
    line_height = 0
    font = JetBrainsMono Nerd Font 10
    format = "%s\n%b"
    alignment = left
    show_age_threshold = 60
    word_wrap = yes

[urgency_low]
    background = "#222222"
    foreground = "#bbbbbb"
    timeout = 5

[urgency_normal]
    background = "#285577"
    foreground = "#ffffff"
    timeout = 8

[urgency_critical]
    background = "#900000"
    foreground = "#ffffff"
    frame_color = "#ff0000"
    timeout = 0

# Shortcuts
[shortcuts]
    close = ctrl+space
    close_all = ctrl+shift+space
    history = ctrl+grave
